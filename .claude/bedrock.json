{
  "project": "earshot",
  "packs": ["python", "typescript", "db", "api-security", "frontend", "jobs"],
  "critical_zones": [
    "server/src/earshot/modules/auth/**",
    "server/src/earshot/modules/share/**",
    "server/src/earshot/modules/ingest/**",
    "server/src/earshot/mcp/**",
    "daemon/src/upload/**"
  ],
  "leaks": {
    "allow": ["claude", "anthropic", "paranoica"],
    "ignore": ["tests/test_leaks.py", "plugins/bedrock/scripts/bedrock_lib/leaks.py"]
  },
  "checks": {
    "file_lines": 400,
    "allow_hosts": ["registry.npmjs.org", "api.npmjs.org", "pypi.org", "pypistats.org", "crates.io"],
    "ignore": [
      "tests/test_codecheck.py",
      "plugins/bedrock/skills/code-review/*",
      "plugins/bedrock/skills/design-creator/*",
      "plugins/bedrock/skills/humanize/*"
    ]
  },
  "commands": {
    "test": {
      "run": "cargo test -q --workspace && uv run --directory server pytest -q && cd tools/checks && uvx pytest -q",
      "heavy": true
    },
    "test-server": {
      "run": "uv run --directory server pytest -q {args}"
    },
    "test-daemon": {
      "run": "cargo test -q --workspace {args}",
      "heavy": true
    },
    "lint": {
      "run": "cargo clippy -q --workspace --all-targets -- -D warnings && uv run --directory server ruff check . && uv run --directory server mypy"
    },
    "format": {
      "run": "cargo fmt --all && uv run --directory server black -q ."
    },
    "template": {
      "run": "uvx pytest -p no:cacheprovider -q -o addopts= && python3 plugins/bedrock/scripts/skillcheck.py --root plugins/bedrock --strict",
      "heavy": true
    }
  }
}
